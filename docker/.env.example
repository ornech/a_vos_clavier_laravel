APP_ENV=production
APP_DEBUG=false
# Généré automatiquement par deploy.sh si vide
APP_KEY=

DB_CONNECTION=mysql
DB_HOST=db
DB_DATABASE=laravel
DB_USERNAME=laravel
DB_PASSWORD=secret
DB_ROOT_PASSWORD=root_secret

# Caches Laravel et storage:link lancés au démarrage par l'image serversideup/php.
# Les migrations, elles, restent volontaires (AUTORUN_LARAVEL_MIGRATION=false dans docker-compose.yaml).
AUTORUN_ENABLED=true

# Logs Laravel visibles avec docker compose logs
LOG_CHANNEL=stderr
